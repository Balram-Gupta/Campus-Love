NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://user:password@cluster.example/campuslove
JWT_SECRET=replace-with-a-long-random-secret

MAILJET_API_KEY=replace-with-your-mailjet-api-key
MAILJET_SECRET_KEY=replace-with-your-mailjet-secret-key
MAIL_FROM=CampusLove <otp@yourdomain.com>
MAIL_TIMEOUT_MS=8000

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional custom SMTP settings. Mailjet defaults to in-v3.mailjet.com:587.
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_USER=replace-with-your-mailjet-api-key
# SMTP_PASS=replace-with-your-mailjet-secret-key
