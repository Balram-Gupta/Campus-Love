{
  "name": "campuslove",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Campus-only dating MVP with React, Express, MongoDB, JWT, uploads, admin approval, swipe, matches, chat, reports, and notifications.",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --config frontend/vite.config.js --host 127.0.0.1 --port 5173",
    "server": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "seed:admin": "node backend/scripts/createAdmin.js",
    "seed:matched-users": "node backend/scripts/seedMatchedUsers.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "nodemon": "^3.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
